<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
    <Appenders>
        <!-- STDOUT Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        
        <!-- ROLLING-FILE Appender -->
        <RollingFile name="RollingFile" fileName="logs/caudal-rfid.log"
                      filePattern="C:\quantumlabs\bepensa-notes\logs\caudal-rfid-%d{yyy-MM-dd}.log">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <!-- SizeBasedTriggeringPolicy size="10 MB"/ -->
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        <!-- RollingFile name="RollingEventsFile" fileName="logs/events-rfid.log"
                      filePattern="logs/events-rfid-%d{MM-dd-yyyy}-%i.log">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile -->
    </Appenders>

    <Loggers>
        <!-- Logger name ="ai.quantumlabs.rfid-events" level="trace" additivity="false">
   	    <AppenderRef ref="RollingEventsFile"/>
        </Logger -->
        <!-- protocolo LLRP interno (org.llrp.ltk) -- INFO log de cada mensaje
             SET_READER_CONFIG/ROSPEC transmitido al lector; util para
             depurar el handshake inicial. Descomentar para silenciarlo
             (sube el nivel de este paquete a "warn" sin tocar el Root).
        <Logger name="org.llrp" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        -->
        <Root level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
         </Root>
    </Loggers>
</Configuration>
